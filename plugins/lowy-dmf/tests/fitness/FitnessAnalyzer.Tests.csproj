<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Core/Core.csproj" />
    <!-- Built for its output only: the tests read Shop.Fixture.dll with Cecil and never load it. -->
    <ProjectReference Include="Fixture/Fixture.csproj" ReferenceOutputAssembly="false" OutputItemType="FixtureAssembly" />
  </ItemGroup>
  <Target Name="CopyFixture" AfterTargets="Build">
    <Copy SourceFiles="Fixture/bin/$(Configuration)/netstandard2.1/Shop.Fixture.dll" DestinationFolder="$(OutDir)fixture" />
  </Target>
</Project>
